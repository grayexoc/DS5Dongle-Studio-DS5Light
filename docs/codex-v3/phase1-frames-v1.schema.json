{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DS5Light V3 Phase 1 host test interchange",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","version","stream_generation","first_sample","frames","sample_rate_hz","layout_id","channels","pcm_s16","discontinuity"],
      "properties": {
        "kind": {"const":"audio_block"},
        "version": {"const":1},
        "stream_generation": {"type":"integer","minimum":1,"maximum":4294967295},
        "first_sample": {"type":"integer","minimum":0,"maximum":9007199254740991},
        "frames": {"type":"integer","minimum":1,"maximum":4096},
        "sample_rate_hz": {"type":"integer","minimum":8000,"maximum":384000},
        "layout_id": {"type":"string","minLength":1,"maxLength":96,"pattern":"^[A-Za-z0-9_.:-]+$"},
        "channels": {"type":"integer","minimum":1,"maximum":32},
        "pcm_s16": {"type":"array","items":{"type":"integer","minimum":-32768,"maximum":32767},"minItems":1,"maxItems":131072},
        "discontinuity": {"type":"boolean"},
        "capture_source": {"enum":["qpc","host_estimate"]},
        "capture_time_us": {"type":"integer","minimum":0,"maximum":9007199254740991}
      },
      "dependencies": {"capture_source":["capture_time_us"],"capture_time_us":["capture_source"]}
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","version","stream_generation","profile_revision","sequence","feature_schema_id","inference_epoch","sample_index","features"],
      "properties": {
        "kind": {"const":"feature_frame"},
        "version": {"const":1},
        "stream_generation": {"type":"integer","minimum":1,"maximum":4294967295},
        "profile_revision": {"type":"integer","minimum":0,"maximum":4294967295},
        "sequence": {"type":"integer","minimum":0,"maximum":4294967295},
        "feature_schema_id": {"type":"string","minLength":1,"maxLength":96,"pattern":"^[A-Za-z0-9_.:-]+$"},
        "inference_epoch": {"type":"integer","minimum":1,"maximum":4294967295},
        "sample_index": {"type":"integer","minimum":0,"maximum":9007199254740991},
        "features": {"type":"array","items":{"type":"number","minimum":-3.4028234663852886e+38,"maximum":3.4028234663852886e+38},"minItems":1,"maxItems":128}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","version","stream_generation","profile_revision","sequence","feature_schema_id","inference_epoch","sample_index","model_id","probabilities","valid"],
      "properties": {
        "kind": {"const":"inference_result"},
        "version": {"const":1},
        "stream_generation": {"type":"integer","minimum":1,"maximum":4294967295},
        "profile_revision": {"type":"integer","minimum":0,"maximum":4294967295},
        "sequence": {"type":"integer","minimum":0,"maximum":4294967295},
        "feature_schema_id": {"type":"string","minLength":1,"maxLength":96,"pattern":"^[A-Za-z0-9_.:-]+$"},
        "inference_epoch": {"type":"integer","minimum":1,"maximum":4294967295},
        "sample_index": {"type":"integer","minimum":0,"maximum":9007199254740991},
        "model_id": {"type":"string","minLength":1,"maxLength":96,"pattern":"^[A-Za-z0-9_.:-]+$"},
        "probabilities": {"type":"array","items":{"type":"number","minimum":0,"maximum":1},"minItems":1,"maxItems":64},
        "valid": {"type":"boolean"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","version","stream_generation","profile_revision","layout_id","first_sample","frames","sample_rate_hz","control_lr"],
      "properties": {
        "kind": {"const":"haptic_frame"},
        "version": {"const":1},
        "stream_generation": {"type":"integer","minimum":1,"maximum":4294967295},
        "profile_revision": {"type":"integer","minimum":0,"maximum":4294967295},
        "layout_id": {"type":"string","minLength":1,"maxLength":96,"pattern":"^[A-Za-z0-9_.:-]+$"},
        "first_sample": {"type":"integer","minimum":0,"maximum":9007199254740991},
        "frames": {"type":"integer","minimum":1,"maximum":4096},
        "sample_rate_hz": {"const":48000},
        "control_lr": {"type":"array","items":{"type":"number","minimum":-1,"maximum":1},"minItems":2,"maxItems":8192}
      }
    }
  ]
}
